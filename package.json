{
  "name": "playwright-production-demo-app-v3-supabase-rbac",
  "version": "3.0.0",
  "description": "Production-style Playwright practice app with Express, Supabase Postgres, RBAC, admin/user pages, UI/API tests.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:schema": "node scripts/apply-schema.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/reset-db.js",
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "playwright test tests/api",
    "test:headed": "playwright test --headed",
    "install:browsers": "playwright install chromium"
  },
  "keywords": [
    "playwright",
    "express",
    "supabase",
    "postgres",
    "rbac",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "nodemon": "^3.1.9"
  }
}
