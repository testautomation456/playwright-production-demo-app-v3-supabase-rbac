# Local or Render environment variables
# Supabase: Project Dashboard -> Connect -> Connection string -> URI
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
JWT_SECRET=replace_this_with_a_long_random_secret
NODE_ENV=development
PORT=3001
# Internal admin password (never commit the real value). Used by db:seed and by the Playwright tests.
ADMIN_PASSWORD=
TEST_ADMIN_PASSWORD=
UPLOAD_DIR=uploads

# Optional: comma-separated origins allowed by CORS (same-origin only when empty)
CORS_ORIGINS=
# Optional: max login attempts per IP per 15 min (default 20 in production, 1000 otherwise)
LOGIN_RATE_LIMIT=
